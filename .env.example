# Copy to .env.local and fill in. All values are optional.

# Public site URL, used for canonical links, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.dotthree.com

# Contact form provider. Any endpoint that accepts a JSON POST works.
#   Formspree:  https://formspree.io/f/<form-id>
#   Web3Forms:  https://api.web3forms.com/submit   (also set the access key below)
# Leave empty to fall back to opening the visitor's email app with the enquiry prefilled.
NEXT_PUBLIC_FORM_ENDPOINT=

# Only needed for providers that expect an access key in the payload (e.g. Web3Forms).
NEXT_PUBLIC_FORM_ACCESS_KEY=
